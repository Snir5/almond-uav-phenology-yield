
## STEP 1 — Convert Reference Raster to RGB

Read bands 3, 2, 1 from the multispectral raster, stretch them to uint8, and save a clean RGB file that will serve as the registration reference for Step 2.

```python
from osgeo import gdal
import numpy as np

input_raster  = r"C:\Users\snirt\kdm_29_02_24\Mosaic_Reference.tif"
output_raster = r"C:\Users\snirt\kdm_29_02_24\Mosaic_Reference_RGB_Fixed.tif"

ds = gdal.Open(input_raster)

print("Reading R(3), G(2), B(1)...")
red   = ds.GetRasterBand(3).ReadAsArray().astype(np.float32)
green = ds.GetRasterBand(2).ReadAsArray().astype(np.float32)
blue  = ds.GetRasterBand(1).ReadAsArray().astype(np.float32)

geo  = ds.GetGeoTransform()
proj = ds.GetProjection()
ds = None

def stretch_to_uint8(band_data, name="band", low_pct=2, high_pct=98):
    valid = band_data[band_data > 0]
    if len(valid) == 0:
        return np.zeros_like(band_data, dtype=np.uint8)
    lo = np.percentile(valid, low_pct)
    hi = np.percentile(valid, high_pct)
    print(f"  {name}: {lo:.4f} -> {hi:.4f}")
    return np.clip((band_data - lo) / (hi - lo) * 255, 0, 255).astype(np.uint8)

print("Stretching to uint8...")
red_u8   = stretch_to_uint8(red,   "Red  (band3)")
green_u8 = stretch_to_uint8(green, "Green(band2)")
blue_u8  = stretch_to_uint8(blue,  "Blue (band1)")

print("Writing RGB Fixed...")
driver = gdal.GetDriverByName('GTiff')
out_ds = driver.Create(
    output_raster, red_u8.shape[1], red_u8.shape[0], 3, gdal.GDT_Byte,
    options=['COMPRESS=LZW', 'TILED=YES', 'BIGTIFF=YES']
)
out_ds.SetGeoTransform(geo)
out_ds.SetProjection(proj)
out_ds.GetRasterBand(1).WriteArray(red_u8)
out_ds.GetRasterBand(2).WriteArray(green_u8)
out_ds.GetRasterBand(3).WriteArray(blue_u8)
out_ds.GetRasterBand(1).SetColorInterpretation(gdal.GCI_RedBand)
out_ds.GetRasterBand(2).SetColorInterpretation(gdal.GCI_GreenBand)
out_ds.GetRasterBand(3).SetColorInterpretation(gdal.GCI_BlueBand)
out_ds.FlushCache()
out_ds = None

print(f"Done! -> {output_raster}")
