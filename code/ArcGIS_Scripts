## STEP 2 — Georeference All Drone Images

Register every TIF image to the reference raster. For each image, extract a temporary RGB file (without band 4), register it, and copy the resulting .aux.xml back to the original file. The process uses three phases: Direct → GPS Offset → Histogram.

```python
import arcpy
import os
import numpy as np
from osgeo import gdal
import json
from collections import deque

input_folder     = r"C:\Users\snirt\kdm_29_02_24\rasters_all"
output_folder    = r"C:\Users\snirt\kdm_29_02_24\Output_Work_Final"
temp_folder      = r"C:\Users\snirt\kdm_29_02_24\Temp_Work"
reference_raster = r"C:\Users\snirt\kdm_29_02_24\Mosaic_Reference_RGB_Fixed.tif"
log_file         = r"C:\Users\snirt\kdm_29_02_24\georef_log_final.json"

MAX_RMS_STRICT  = 2.0
MAX_RMS_NORMAL  = 5.0
MAX_RMS_RELAXED = 10.0
MAX_RMS_LAST    = 15.0
HIST_THRESHOLD  = 30

arcpy.env.overwriteOutput = True
for folder in [output_folder, temp_folder]:
    if not os.path.exists(folder):
        os.makedirs(folder)

def extract_rgb_temp(input_path, temp_path):
    try:
        ds = gdal.Open(input_path)
        r  = ds.GetRasterBand(1).ReadAsArray().astype(np.uint8)
        g  = ds.GetRasterBand(2).ReadAsArray().astype(np.uint8)
        b  = ds.GetRasterBand(3).ReadAsArray().astype(np.uint8)
        geo  = ds.GetGeoTransform()
        proj = ds.GetProjection()
        ds = None
        driver = gdal.GetDriverByName('GTiff')
        out = driver.Create(temp_path, r.shape[1], r.shape[0], 3,
                            gdal.GDT_Byte, options=['COMPRESS=LZW'])
        out.SetGeoTransform(geo)
        out.SetProjection(proj)
        out.GetRasterBand(1).WriteArray(r)
        out.GetRasterBand(2).WriteArray(g)
        out.GetRasterBand(3).WriteArray(b)
        out.GetRasterBand(1).SetColorInterpretation(gdal.GCI_RedBand)
        out.GetRasterBand(2).SetColorInterpretation(gdal.GCI_GreenBand)
        out.GetRasterBand(3).SetColorInterpretation(gdal.GCI_BlueBand)
        out.FlushCache()
        out = None
        return True
    except:
        return False

def copy_aux_to_original(temp_rgb_path, out_path):
    import shutil
    aux_src = temp_rgb_path + ".aux.xml"
    aux_dst = out_path + ".aux.xml"
    if os.path.exists(aux_src):
        shutil.copy2(aux_src, aux_dst)
        return True
    return False

def needs_histogram_matching(input_raster, reference_raster, threshold=HIST_THRESHOLD):
    try:
        in_ds    = gdal.Open(input_raster)
        in_array = in_ds.ReadAsArray()
        ref_ds   = gdal.Open(reference_raster)
        sz = min(500, ref_ds.RasterXSize, ref_ds.RasterYSize)
        xo = (ref_ds.RasterXSize - sz) // 2
        yo = (ref_ds.RasterYSize - sz) // 2
        ref_array = ref_ds.ReadAsArray(xo, yo, sz, sz)
        diffs = []
        bands = range(min(3, in_array.shape[0])) if in_array.ndim == 3 else [0]
        for band in bands:
            in_band  = in_array[band] if in_array.ndim == 3 else in_array
            ref_band = ref_array[band] if ref_array.ndim == 3 else ref_array
            diffs.append(abs(np.mean(in_band[in_band > 0]) -
                             np.mean(ref_band[ref_band > 0])))
        in_ds = None; ref_ds = None
        return np.mean(diffs) > threshold, np.mean(diffs)
    except:
        return True, 999

def match_histogram_1d(src, ref):
    src_data = src[src > 0]; ref_data = ref[ref > 0]
    if len(src_data) == 0 or len(ref_data) == 0:
        return src
    src_values, src_counts = np.unique(src_data, return_counts=True)
    ref_values, ref_counts = np.unique(ref_data, return_counts=True)
    src_cdf = np.cumsum(src_counts).astype(np.float64) / src_counts.sum()
    ref_cdf = np.cumsum(ref_counts).astype(np.float64) / ref_counts.sum()
    interp_values = np.interp(src_cdf, ref_cdf, ref_values)
    lookup = np.arange(256, dtype=np.uint8)
    for j, val in enumerate(src_values):
        if 0 < val < 256:
            lookup[int(val)] = int(np.clip(interp_values[j], 0, 255))
    return lookup[src]

def apply_histogram_matching(input_path, reference_raster, output_path):
    try:
        in_ds     = gdal.Open(input_path)
        in_array  = in_ds.ReadAsArray()
        geo       = in_ds.GetGeoTransform()
        proj      = in_ds.GetProjection()
        num_bands = in_ds.RasterCount
        ref_ds    = gdal.Open(reference_raster)
        sz = min(2000, ref_ds.RasterXSize, ref_ds.RasterYSize)
        xo = (ref_ds.RasterXSize - sz) // 2
        yo = (ref_ds.RasterYSize - sz) // 2
        ref_array = ref_ds.ReadAsArray(xo, yo, sz, sz)
        matched = np.copy(in_array)
        if in_array.ndim == 3:
            for b in range(min(3, in_array.shape[0])):
                if ref_array.ndim == 3 and ref_array.shape[0] > b:
                    matched[b] = match_histogram_1d(in_array[b], ref_array[b])
        driver = gdal.GetDriverByName('GTiff')
        out = driver.Create(output_path, in_ds.RasterXSize, in_ds.RasterYSize,
                            num_bands, gdal.GDT_Byte, options=['COMPRESS=LZW'])
        out.SetGeoTransform(geo); out.SetProjection(proj)
        if matched.ndim == 2:
            out.GetRasterBand(1).WriteArray(matched)
        else:
            for b in range(matched.shape[0]):
                out.GetRasterBand(b + 1).WriteArray(matched[b])
        out.FlushCache(); out = None; in_ds = None; ref_ds = None
        return True
    except:
        return False

class OffsetTracker:
    def __init__(self, window=10):
        self.offsets = deque(maxlen=window)
    def add_offset(self, orig, reg):
        self.offsets.append((reg[0] - orig[0], reg[1] - orig[1]))
    def get_average_offset(self):
        if len(self.offsets) < 3:
            return None
        return (np.mean([o[0] for o in self.offsets]),
                np.mean([o[1] for o in self.offsets]))
    def apply_offset_to_file(self, path, dx, dy):
        try:
            ds  = gdal.Open(path, gdal.GA_Update)
            geo = list(ds.GetGeoTransform())
            geo[0] += dx; geo[3] += dy
            ds.SetGeoTransform(tuple(geo))
            ds.FlushCache(); ds = None
            return True
        except:
            return False

tracker = OffsetTracker(window=10)

def try_register(original_input, out_path, reference_raster, rms,
                 method_name="direct", use_histogram=False, pre_offset=None):
    temp_rgb  = os.path.join(temp_folder, f"rgb_{os.path.basename(original_input)}")
    temp_hist = os.path.join(temp_folder, f"hist_{os.path.basename(original_input)}")
    try:
        if not arcpy.Exists(out_path):
            arcpy.management.CopyRaster(original_input, out_path)
        source_for_reg = original_input
        if use_histogram:
            if not apply_histogram_matching(original_input, reference_raster, temp_hist):
                return None
            source_for_reg = temp_hist
        if not extract_rgb_temp(source_for_reg, temp_rgb):
            return None
        if pre_offset:
            tracker.apply_offset_to_file(temp_rgb, pre_offset[0], pre_offset[1])
        arcpy.management.RegisterRaster(
            in_raster=temp_rgb, register_mode="REGISTER",
            reference_raster=reference_raster,
            transformation_type="POLYORDER1", maximum_rms_value=rms
        )
        copy_aux_to_original(temp_rgb, out_path)
        return method_name
    except:
        return None
    finally:
        for f in [temp_rgb, temp_hist]:
            for ext in ["", ".aux.xml", ".ovr", ".rrd"]:
                p = f + ext
                if os.path.exists(p):
                    try: os.remove(p)
                    except: pass

if os.path.exists(log_file):
    with open(log_file, 'r') as f:
        log = json.load(f)
    log['failed'] = []
    print(f"Resuming: {len(log.get('success', []))} already done")
else:
    log = {"success": [], "failed": [], "methods": {}}
    print("Starting fresh")

def save_log():
    with open(log_file, 'w') as f:
        json.dump(log, f, indent=2)

print("Preparing reference...")
try:
    arcpy.management.BuildPyramids(reference_raster, pyramid_level=-1)
except:
    pass

arcpy.env.workspace = input_folder
raster_list = arcpy.ListRasters("*.tif", "TIF")

print(f"Processing {len(raster_list)} images...")
success_this_run = 0
failed_this_run  = 0
hist_applied     = 0

for i, raster_name in enumerate(raster_list, 1):
    in_path  = os.path.join(input_folder,  raster_name)
    out_path = os.path.join(output_folder, raster_name)

    if raster_name in log.get('success', []):
        print(f"[{i}] SKIP {raster_name[:40]}")
        continue

    print(f"[{i}/{len(raster_list)}] {raster_name[:38]:38s} ", end="", flush=True)
    used_method = None

    try:
        if arcpy.Exists(out_path):
            arcpy.management.Delete(out_path)

        for rms in [MAX_RMS_STRICT, MAX_RMS_NORMAL, MAX_RMS_RELAXED]:
            result = try_register(in_path, out_path, reference_raster,
                                  rms, method_name="direct")
            if result:
                try:
                    orig = arcpy.Describe(in_path).extent
                    reg  = arcpy.Describe(out_path).extent
                    tracker.add_offset(
                        ((orig.XMin+orig.XMax)/2, (orig.YMin+orig.YMax)/2),
                        ((reg.XMin+reg.XMax)/2,   (reg.YMin+reg.YMax)/2))
                except:
                    pass
                print(f"Direct (RMS<{rms:.0f}m)")
                used_method = "direct"
                break

        if not used_method:
            avg = tracker.get_average_offset()
            if avg:
                if arcpy.Exists(out_path): arcpy.management.Delete(out_path)
                for rms in [MAX_RMS_STRICT, MAX_RMS_NORMAL, MAX_RMS_RELAXED]:
                    result = try_register(in_path, out_path, reference_raster,
                                          rms, method_name="offset", pre_offset=avg)
                    if result:
                        print(f"Offset (dx={avg[0]:.1f}m, RMS<{rms:.0f}m)")
                        used_method = "offset"
                        break

        if not used_method:
            if arcpy.Exists(out_path): arcpy.management.Delete(out_path)
            need_hist, diff = needs_histogram_matching(in_path, reference_raster)
            if not need_hist:
                result = try_register(in_path, out_path, reference_raster,
                                      MAX_RMS_LAST, method_name="relaxed")
                if result:
                    print(f"Relaxed RMS<{MAX_RMS_LAST:.0f}m (diff={diff:.1f})")
                    used_method = "relaxed"
            else:
                hist_applied += 1
                for rms in [MAX_RMS_STRICT, MAX_RMS_NORMAL, MAX_RMS_RELAXED, MAX_RMS_LAST]:
                    result = try_register(in_path, out_path, reference_raster,
                                          rms, method_name="hist", use_histogram=True)
                    if result:
                        print(f"Hist (diff={diff:.1f}, RMS<{rms:.0f}m)")
                        used_method = "hist"
                        break

        if used_method:
            success_this_run += 1
            log['success'].append(raster_name)
            log['methods'][raster_name] = used_method
            save_log()
        else:
            print("FAILED")
            failed_this_run += 1
            log['failed'].append(raster_name)
            save_log()
            if arcpy.Exists(out_path):
                arcpy.management.Delete(out_path)

    except Exception as e:
        print(f"ERROR: {str(e)[:40]}")
        failed_this_run += 1
        log['failed'].append(raster_name)
        save_log()

print(f"Done: {success_this_run} success | {failed_this_run} failed | {hist_applied} histogram")
