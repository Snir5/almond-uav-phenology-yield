gdb_path          = r"C:\Users\snirt\01_03_23\Mosaics\Mosaics.gdb"
mosaic_4band_name = "Mosaic_4Band"
mosaic_rgb_name   = "Mosaic_RGB"
export_folder     = r"C:\Users\snirt\01_03_23\Final_Exports"

os.makedirs(export_folder, exist_ok=True)

# Full paths to the mosaics inside the GDB
mosaic_4band_path = os.path.join(gdb_path, mosaic_4band_name)
mosaic_rgb_path   = os.path.join(gdb_path, mosaic_rgb_name)

# ==========================================
# EXPORT 1: HIGH-RES 4-BAND TIFF (Target < 5GB)
# ==========================================
def export_4band_tiff(in_mosaic, out_folder):
    out_name = "Final_Orthomosaic_4Band.tif"
    out_path = os.path.join(out_folder, out_name)
    
    if arcpy.Exists(out_path):
        arcpy.management.Delete(out_path)
        
    print(f"Exporting 4-Band TIFF with LZW Compression (Lossless)...")
    print(f"Destination: {out_path}")
    
    # Enable LZW compression to significantly reduce file size without losing data
    arcpy.env.compression = "LZW"
    
    arcpy.management.CopyRaster(
        in_raster=in_mosaic,
        out_rasterdataset=out_path,
        format="TIFF",
        pixel_type="8_BIT_UNSIGNED",
        nodata_value="256" # Preserves transparency at the edges
        # Note: If the file is still >5GB, you can force a lower resolution by adding:
        # cell_size="0.05" (which means 5cm per pixel)
    )
    print("  Done exporting 4-Band TIFF.\n")

# ==========================================
# EXPORT 2: HIGH-RES RGB IMAGE (JPEG Compression)
# ==========================================
def export_rgb_image(in_mosaic, out_folder):
    # We use .tif extension but with JPEG compression. 
    # This acts exactly like a JPEG (small file size) but supports transparent backgrounds!
    out_name = "Final_Orthomosaic_RGB.tif"
    out_path = os.path.join(out_folder, out_name)
    
    if arcpy.Exists(out_path):
        arcpy.management.Delete(out_path)
        
    print(f"Exporting RGB Image with JPEG Compression (High Quality, Small Size)...")
    print(f"Destination: {out_path}")
    
    # Set compression to JPEG with 90% quality (excellent visual quality, tiny file size)
    arcpy.env.compression = "JPEG 90"
    
    arcpy.management.CopyRaster(
        in_raster=in_mosaic,
        out_rasterdataset=out_path,
        format="TIFF",
        pixel_type="8_BIT_UNSIGNED",
        nodata_value="256"
    )
    print("  Done exporting RGB Image.\n")

# ==========================================
# EXECUTION
# ==========================================
print("Starting Exports...\n" + "="*50)

try:
    # 1. Export the analytical 4-Band map
    export_4band_tiff(mosaic_4band_path, export_folder)
    
    # 2. Export the visual RGB map
    export_rgb_image(mosaic_rgb_path, export_folder)
    
    print("ALL EXPORTS COMPLETED SUCCESSFULLY.")
    print("Check your files in:", export_folder)
    
except Exception as e:
    print(f"ERROR during export: {e}")
