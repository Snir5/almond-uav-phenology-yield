## STEP 4 — Build Final Mosaics

Filter out poor images using four quality criteria, then build two mosaics: **Mosaic_4Band** (4-band TIF with overviews for ML analysis) and **Mosaic_RGB** (3-band JPEG for display).

```python
import arcpy
import os
import shutil
import numpy as np
import xml.etree.ElementTree as ET

output_folder     = r"C:\Users\snirt\kdm_29_02_24\Output_Work_Final"
mosaic_folder     = r"C:\Users\snirt\kdm_29_02_24\Mosaics"
gdb_path          = r"C:\Users\snirt\kdm_29_02_24\Mosaics\Mosaics.gdb"
mosaic_4band_name = "Mosaic_4Band"
mosaic_rgb_name   = "Mosaic_RGB"

os.makedirs(mosaic_folder, exist_ok=True)

# Confirmed: 4 bands (R,G,B,Mask), U8, band4: 1=tree / NoData=background
MIN_GCPS        = 10
MAX_MEAN_SHIFT  = 15.0
MAX_MAX_SHIFT   = 40.0
MAX_SIZE_FACTOR = 1.5

for temp_dir in [os.path.join(mosaic_folder, "temp_rgb"),
                 os.path.join(mosaic_folder, "temp_nir")]:
    if os.path.exists(temp_dir):
        shutil.rmtree(temp_dir)
        print(f"Deleted temp folder: {temp_dir}")
print("Cleanup done\n")

def analyze_aux(aux_path):
    try:
        tree = ET.parse(aux_path)
        root = tree.getroot()
        src_nodes = root.findall(".//SourceGCPs/Double")
        tgt_nodes = root.findall(".//TargetGCPs/Double")
        if not src_nodes or not tgt_nodes:
            return 0, 999, 999
        src = [(float(src_nodes[j].text), float(src_nodes[j+1].text))
               for j in range(0, len(src_nodes), 2)]
        tgt = [(float(tgt_nodes[j].text), float(tgt_nodes[j+1].text))
               for j in range(0, len(tgt_nodes), 2)]
        shifts = [np.sqrt((t[0]-s[0])**2 + (t[1]-s[1])**2)
                  for s, t in zip(src, tgt)]
        return len(shifts), np.mean(shifts), np.max(shifts)
    except:
        return 0, 999, 999

all_files = sorted([f for f in os.listdir(output_folder) if f.endswith(".tif")])
sizes = {}
print(f"Scanning {len(all_files)} images...")
for name in all_files:
    try:
        ext = arcpy.Describe(os.path.join(output_folder, name)).extent
        sizes[name] = (ext.XMax - ext.XMin, ext.YMax - ext.YMin)
    except:
        pass

median_w = np.median([s[0] for s in sizes.values()])
median_h = np.median([s[1] for s in sizes.values()])
MAX_W    = median_w * MAX_SIZE_FACTOR
MAX_H    = median_h * MAX_SIZE_FACTOR
print(f"Median: {median_w:.1f}m x {median_h:.1f}m  |  Max: {MAX_W:.1f}m x {MAX_H:.1f}m\n")

bad_images = set()
for name in all_files:
    tif_path = os.path.join(output_folder, name)
    aux_path = tif_path + ".aux.xml"
    if not os.path.exists(aux_path):
        bad_images.add(name); continue
    n, mean_s, max_s = analyze_aux(aux_path)
    if n < MIN_GCPS: bad_images.add(name)
    if mean_s > MAX_MEAN_SHIFT or max_s > MAX_MAX_SHIFT: bad_images.add(name)
    if name in sizes:
        w, h = sizes[name]
        if w > MAX_W or h > MAX_H: bad_images.add(name)

good_images = [f for f in all_files if f not in bad_images]
print(f"Total:{len(all_files)}  Good:{len(good_images)}  Bad:{len(bad_images)}\n")

with open(os.path.join(mosaic_folder, "bad_images.txt"), 'w') as f:
    for name in sorted(bad_images):
        f.write(f"{name}\n")

if not arcpy.Exists(gdb_path):
    arcpy.CreateFileGDB_management(mosaic_folder, "Mosaics.gdb")
    print(f"Created GDB: {gdb_path}\n")

spatial_ref = arcpy.SpatialReference(32636)  # WGS 1984 UTM Zone 36N

def add_rasters_in_batches(mosaic_path, full_paths, batch_size=200):
    for i in range(0, len(full_paths), batch_size):
        batch = full_paths[i:i+batch_size]
        arcpy.AddRastersToMosaicDataset_management(
            in_mosaic_dataset=mosaic_path, raster_type="Raster Dataset",
            input_path=";".join(batch), update_cellsize_ranges="UPDATE_CELL_SIZES",
            update_boundary="UPDATE_BOUNDARY", update_overviews="NO_OVERVIEWS",
            duplicate_items_action="ALLOW_DUPLICATES"
        )
        print(f"  Batch {i//batch_size + 1}: {len(batch)} images added")

def build_4band_mosaic(mosaic_name, image_list, spatial_ref, gdb_path):
    mosaic_path = os.path.join(gdb_path, mosaic_name)
    if arcpy.Exists(mosaic_path):
        arcpy.Delete_management(mosaic_path)
        print(f"Deleted existing: {mosaic_name}")
    print(f"Creating {mosaic_name} - 4 bands TIF ({len(image_list)} images)...")
    arcpy.CreateMosaicDataset_management(
        in_workspace=gdb_path, in_mosaicdataset_name=mosaic_name,
        coordinate_system=spatial_ref, num_bands=4, pixel_type="8_BIT_UNSIGNED"
    )
    arcpy.SetMosaicDatasetProperties_management(
        in_mosaic_dataset=mosaic_path, mosaic_operator="FIRST"
    )
    add_rasters_in_batches(mosaic_path, [os.path.join(output_folder, f) for f in image_list])
    print(f"  Building boundary...")
    arcpy.BuildBoundary_management(mosaic_path)
    print(f"  Building overviews...")
    arcpy.BuildOverviews_management(
        in_mosaic_dataset=mosaic_path,
        define_missing_tiles="DEFINE_MISSING_TILES",
        generate_overviews="GENERATE_OVERVIEWS",
        generate_missing_images="GENERATE_MISSING_IMAGES",
        regenerate_stale_images="REGENERATE_STALE_IMAGES"
    )
    print(f"  Done: {mosaic_name}\n")
    return mosaic_path

def build_rgb_jpeg_mosaic(mosaic_name, image_list, spatial_ref, gdb_path):
    mosaic_path = os.path.join(gdb_path, mosaic_name)
    if arcpy.Exists(mosaic_path):
        arcpy.Delete_management(mosaic_path)
        print(f"Deleted existing: {mosaic_name}")
    print(f"Creating {mosaic_name} - 3 bands JPEG ({len(image_list)} images)...")
    arcpy.CreateMosaicDataset_management(
        in_workspace=gdb_path, in_mosaicdataset_name=mosaic_name,
        coordinate_system=spatial_ref, num_bands=3, pixel_type="8_BIT_UNSIGNED"
    )
    arcpy.SetMosaicDatasetProperties_management(
        in_mosaic_dataset=mosaic_path, mosaic_operator="FIRST", JPEG_quality=85
    )
    add_rasters_in_batches(mosaic_path, [os.path.join(output_folder, f) for f in image_list])

    # Save .rft.xml to file — inline XML not supported by ArcGIS
    rft_path = os.path.join(mosaic_folder, "extract_rgb.rft.xml")
    with open(rft_path, 'w') as f:
        f.write("""<RasterFunctionTemplate xsi:type='typens:RasterFunctionTemplate'
    xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xmlns:xs='http://www.w3.org/2001/XMLSchema'
    xmlns:typens='http://www.esri.com/schemas/ArcGIS/3.0'>
  <Name>ExtractRGB</Name>
  <Function xsi:type='typens:ExtractBandFunction'>
    <BandIDs>
      <Long>0</Long>
      <Long>1</Long>
      <Long>2</Long>
    </BandIDs>
  </Function>
</RasterFunctionTemplate>""")

    print(f"  Extracting RGB bands only (dropping band 4)...")
    arcpy.EditRasterFunction_management(
        in_mosaic_dataset=mosaic_path,
        edit_mosaic_dataset_item="EDIT_MOSAIC_DATASET",
        edit_options="INSERT",
        function_chain_definition=rft_path
    )
    print(f"  Building boundary...")
    arcpy.BuildBoundary_management(mosaic_path)
    print(f"  Done: {mosaic_name}\n")
    return mosaic_path

path_4band = build_4band_mosaic(mosaic_4band_name, good_images, spatial_ref, gdb_path)
path_rgb   = build_rgb_jpeg_mosaic(mosaic_rgb_name, good_images, spatial_ref, gdb_path)

print(f"{'='*50}")
print(f"DONE")
print(f"  4-Band TIF: {path_4band}  ({len(good_images)} images)")
print(f"  RGB JPEG:   {path_rgb}   ({len(good_images)} images)")
print(f"{'='*50}")
